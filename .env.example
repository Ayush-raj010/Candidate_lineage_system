# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- AI summaries ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_SECONDS=30

# --- Sign-in and sessions ---
# Signs CSRF tokens. At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is used per server start (fine for local use; tokens refresh automatically).
GCCX_SECRET_KEY=
# Secure cookie flag: auto (Secure when the request is HTTPS), always (set this in production), never.
GCCX_COOKIE_SECURE=auto
# GCCX_SESSION_IDLE_MINUTES=120
# GCCX_SESSION_MAX_HOURS=12
# Failed sign-ins allowed per email (and per IP) within the window before sign-in is paused.
# GCCX_LOGIN_WINDOW_MINUTES=15
# GCCX_LOGIN_MAX_FAILURES=5
# GCCX_LOGIN_MAX_FAILURES_PER_IP=30
# List the demo accounts (python -m app.manage create-demo) on the sign-in page. Local demos only.
# GCCX_DEMO_LOGIN=1
