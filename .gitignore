# --- Secrets ---
# .env holds GROQ_API_KEY and GCCX_SECRET_KEY. The template is safe to commit.
.env
.env.*
!.env.example

# --- Databases ---
# Generated by init_db.py and app.manage; they contain accounts (password hashes),
# sessions and the audit log. Migration backups (*.bak) contain the same data.
# The app creates data/ itself.
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.bak
*.bak-wal
*.bak-shm

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node (frontend tests) ---
node_modules/
npm-debug.log*

# --- Logs ---
*.log

# --- Editors and OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code local settings ---
.claude/settings.local.json
